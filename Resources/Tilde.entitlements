<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime blocks the camera and the microphone without these: Tilde records
       an iPhone's screen and shows the camera bubble through the camera, and records sound
       with a camera clip (NSCameraUsageDescription, NSMicrophoneUsageDescription). -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
