   ]
  }
 },
 {
  "name": "Holding does nothing while typing a comment",
  "state": {
   "commentOpen": true
  },
  "event": "holdBegan",
  "expect": {
   "state": {
    "holdPaused": false
   },
   "effects": []
  }
 },
 {
  "name": "Holding does nothing in the preview",
  "state": {
   "previewOpen": true
  },
  "event": "holdBegan",
  "expect": {
   "effects": []
  }
 },
 {
  "name": "Holding does nothing while paused",
  "state": {
   "paused": true
  },
  "event": "holdBegan",
  "expect": {
   "effects": []
  }
 },
 {
  "name": "Holding does nothing with no session",
  "state": {
   "isAnnotating": false,
   "hasSession": false
  },
  "event": "holdBegan",
  "expect": {
   "effects": []
  }
 },
 {
  "name": "Letting go resumes",
  "state": {
   "holdPaused": true
  },
  "event": "holdEnded",
  "expect": {
   "state": {
    "holdPaused": false
   },
   "effects": [
    "plainClicksOff",
    "applyPause"
   ]
  }
 },
 {
  "name": "Letting go after no hold does nothing",
  "state": {},
  "event": "holdEnded",
  "expect": {
   "effects": []
  }
 },
 {
  "name": "Another app in front pauses a scoped session",
  "state": {},
  "event": "otherAppInFront",
  "expect": {
   "state": {
    "autoPaused": true
   },
   "effects": [
    "applyPause",
    "showOtherAppNotice"
   ]
  }
 },
 {
  "name": "Its app in front again resumes",
  "state": {
   "autoPaused": true
  },
  "event": "scopeAppInFront",
  "expect": {
   "state": {
    "autoPaused": false
   },
   "effects": [
    "applyPause"
   ]
  }
 },
 {
