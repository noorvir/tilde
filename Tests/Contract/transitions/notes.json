[
 {
  "name": "The same address is the same page, whatever the title",
  "original": {
   "url": "https://x.com/home",
   "title": "Home / X"
  },
  "page": {
   "url": "https://x.com/home",
   "title": "(1) Home / X"
  },
  "expect": {
   "samePage": true
  }
 },
 {
  "name": "Another address is another page, with the same title",
  "original": {
   "url": "https://x.com/home",
   "title": "T"
  },
  "page": {
   "url": "https://x.com/explore",
   "title": "T"
  },
  "expect": {
   "samePage": false
  }
 },
 {
  "name": "A single page app route is another page",
  "original": {
   "url": "http://a/spa.html",
   "title": "T"
  },
  "page": {
   "url": "http://a/spa.html?route=b",
   "title": "T"
  },
  "expect": {
   "samePage": false
  }
 },
 {
  "name": "Another title is another page in a native app",
  "original": {
   "title": "Sound"
  },
  "page": {
   "title": "Keyboard"
  },
  "expect": {
   "samePage": false
  }
 },
 {
  "name": "The same title cannot tell: the picture decides",
  "original": {
   "title": "iPhone 16"
  },
  "page": {
   "title": "iPhone 16"
  },
  "expect": {
   "samePage": null
  }
 },
 {
  "name": "A failed address read does not hide the note",
  "original": {
   "url": "https://x.com/home",
   "title": "T"
  },
  "page": {
   "title": "T"
  },
  "expect": {
   "samePage": null
  }
 },
 {
  "name": "One bad reading does not hide a note",
  "note": {
   "isVisible": true,
   "readings": 0
  },
  "similarity": 0.1,
  "expect": {
   "note": {
    "isVisible": true
   }
  }
 },
 {
  "name": "Two bad readings hide it",
  "note": {
   "isVisible": true,
   "readings": 1
  },
  "similarity": 0.1,
  "expect": {
   "note": {
    "isVisible": false
   }
  }
 },
 {
  "name": "One good reading does not show it",
  "note": {
   "isVisible": false,
   "readings": 0
  },
  "similarity": 0.99,
  "expect": {
   "note": {
    "isVisible": false
   }
  }
 },
 {
  "name": "Two good readings show it",
  "note": {
   "isVisible": false,
   "readings": 1
  },
  "similarity": 0.99,
  "expect": {
   "note": {
    "isVisible": true
   }
  }
 },
 {
  "name": "A reading between the thresholds changes nothing",
  "note": {
   "isVisible": true,
   "readings": 1
  },
  "similarity": 0.975,
  "expect": {
   "note": {
    "isVisible": true
   }
  }
 },
 {
  "name": "A region in a window without elements: content changed, twice, hides it",
  "note": {
   "isVisible": true,
   "readings": 1
  },
  "similarity": 0.85,
  "expect": {
   "note": {
    "isVisible": false
   }
  }
 },
 {
  "name": "A region in a window without elements: content restored, twice, shows it",
  "note": {
   "isVisible": false,
   "readings": 1
  },
  "similarity": 0.99,
  "expect": {
   "note": {
    "isVisible": true
   }
  }
 },
 {
  "name": "Another page hides a label",
  "isElementConfirmed": true,
  "original": {
   "url": "https://x.com/a",
   "title": "T"
  },
  "page": {
   "url": "https://x.com/b",
   "title": "T"
  },
  "expect": {
   "samePage": false,
   "hides": true,
   "pictureDecides": false
  }
 },
 {
  "name": "The same address with its element: the label stays",
  "isElementConfirmed": true,
  "original": {
   "url": "https://x.com/a",
   "title": "T"
  },
  "page": {
   "url": "https://x.com/a",
   "title": "T"
  },
  "expect": {
   "samePage": true,
   "hides": false,
   "pictureDecides": false
  }
 },
 {
  "name": "The same address with its element gone: the picture decides",
  "isElementConfirmed": false,
  "original": {
   "url": "https://x.com/a",
   "title": "T"
  },
  "page": {
   "url": "https://x.com/a",
   "title": "T"
  },
  "expect": {
   "samePage": true,
   "hides": false,
   "pictureDecides": true
  }
 },
 {
  "name": "A picture with nothing alike hides at once",
  "note": {
   "isVisible": true,
   "readings": 0
  },
  "similarity": 0,
  "expect": {
   "note": {
    "isVisible": false
   }
  }
 },
 {
  "name": "An element out of its window has no label",
  "elementFrame": [
   900,
   100,
   100,
   20
  ],
  "windowFrame": [
   0,
   0,
   500,
   400
  ],
  "expect": {
   "labelShows": false
  }
 },
 {
  "name": "An element in its window has its label",
  "elementFrame": [
   100,
   100,
   100,
   20
  ],
  "windowFrame": [
   0,
   0,
   500,
   400
  ],
  "expect": {
   "labelShows": true
  }
 },
 {
  "name": "Within 8 points of a label is on it, not on the element below",
  "labelDistance": 17,
  "expect": {
   "isOnLabel": true
  }
 },
 {
  "name": "Further away is on the element",
  "labelDistance": 19,
  "expect": {
   "isOnLabel": false
  }
 },
 {
  "name": "A push to every machine says where the images are",
  "pushed": [
   "mac-mini",
   "devbox"
  ],
  "failed": [],
  "expect": {
   "confirmation": "Copied, images on mac-mini, devbox"
  }
 },
 {
  "name": "A failed push names the machine",
  "pushed": [
   "devbox"
  ],
  "failed": [
   "mac-mini"
  ],
  "expect": {
   "confirmation": "Copied, mac-mini failed"
  }
 },
 {
  "name": "A host cannot be an ssh option",
  "pushHost": "-oProxyCommand=x",
  "expect": {
   "hostIsValid": false
  }
 },
 {
  "name": "A host cannot hold a command",
  "pushHost": "a;rm",
  "expect": {
   "hostIsValid": false
  }
 },
 {
  "name": "An ssh config gives its named hosts, not its patterns",
  "sshConfig": "Host mac-mini mac-mini-ts\n  User alex\nHost *\n  ForwardAgent no\nhost devbox\n",
  "expect": {
   "hosts": [
    "mac-mini",
    "mac-mini-ts",
    "devbox"
   ]
  }
 },
 {
  "name": "Running ssh connections name their nodes",
  "processList": "/usr/bin/ssh -o BatchMode=yes -p 22 alex@mac-mini ls\nssh devbox\nsshd: /usr/sbin/sshd\nvim x",
  "expect": {
   "hosts": [
    "mac-mini",
    "devbox"
   ]
  }
 },
 {
  "name": "Aliases of one address, or with one machine name, are one machine; an installed name shows",
  "installed": [
   "mac-mini-ts"
  ],
  "aliases": [
   {
    "host": "mac-mini",
    "machineName": "alex",
    "address": "100.64.0.10:22"
   },
   {
    "host": "100.64.0.10",
    "address": "100.64.0.10:22"
   },
   {
    "host": "mac-mini-ts",
    "machineName": "alex",
    "address": "100.64.0.10:22"
   },
   {
    "host": "mac-mini-lan",
    "machineName": "alex",
    "address": "192.168.1.20:22"
   },
   {
    "host": "acroduck",
    "address": "10.0.0.1:22"
   }
  ],
  "expect": {
   "machines": [
    [
     "mac-mini-ts",
     "mac-mini",
     "100.64.0.10",
     "mac-mini-lan"
    ],
    [
     "acroduck"
    ]
   ]
  }
 },
 {
  "name": "With no name, an address shows last",
  "aliases": [
   {
    "host": "10.0.0.2",
    "address": "10.0.0.2:22"
   },
   {
    "host": "box",
    "address": "10.0.0.2:22"
   }
  ],
  "expect": {
   "machines": [
    [
     "box",
     "10.0.0.2"
    ]
   ]
  }
 },
 {
  "name": "A linked machine has a green dot",
  "nodeStatus": "linked",
  "isReachable": true,
  "expect": {
   "dot": "green"
  }
 },
 {
  "name": "A reachable machine with nothing installed is yellow",
  "nodeStatus": "notInstalled",
  "isReachable": true,
  "expect": {
   "dot": "yellow"
  }
 },
 {
  "name": "An installed machine whose link is not up yet is yellow",
  "nodeStatus": "unreachable",
  "isReachable": true,
  "expect": {
   "dot": "yellow"
  }
 },
 {
  "name": "A machine that does not answer is grey",
  "nodeStatus": "unreachable",
  "isReachable": false,
  "expect": {
   "dot": "grey"
  }
 },
 {
  "name": "A failed link on a reachable machine is red",
  "nodeStatus": "unreachable",
  "isReachable": true,
  "hasFailed": true,
  "expect": {
   "dot": "red"
  }
 },
 {
  "name": "A machine's Install sets up the apps that are on this Mac and on the machine",
  "foundOnMachine": [
   "claude-code",
   "codex",
   "gemini"
  ],
  "onThisMac": [
   "claude-code",
   "codex",
   "cursor"
  ],
  "expect": {
   "chosen": [
    "claude-code",
    "codex"
   ]
  }
 },
 {
  "name": "With no agent on this Mac, all those found are chosen",
  "foundOnMachine": [
   "codex"
  ],
  "onThisMac": [],
  "expect": {
   "chosen": [
    "codex"
   ]
  }
 }
]
