{"name": "⌃ tapped twice, each press and the gap at most 300 ms, is a double tap", "watching": ["control"], "keys": [{"down": ["control"], "at": 0}, {"at": 0.1}, {"down": ["control"], "at": 0.25}, {"at": 0.35}], "expect": {"doubleTaps": ["control"]}},
{"name": "A press longer than 300 ms is no tap", "watching": ["control"], "keys": [{"down": ["control"], "at": 0}, {"at": 0.4}, {"down": ["control"], "at": 0.5}, {"at": 0.6}], "expect": {"doubleTaps": []}},
{"name": "A second press more than 300 ms after the first release is no double tap", "watching": ["control"], "keys": [{"down": ["control"], "at": 0}, {"at": 0.1}, {"down": ["control"], "at": 0.5}, {"at": 0.6}], "expect": {"doubleTaps": []}},
{"name": "A key or click between the taps makes it nothing", "watching": ["control"], "keys": [{"down": ["control"], "at": 0}, {"at": 0.1}, {"other": true, "at": 0.15}, {"down": ["control"], "at": 0.2}, {"at": 0.3}], "expect": {"doubleTaps": []}},
{"name": "Another modifier with it is a chord, not a tap", "watching": ["control"], "keys": [{"down": ["control"], "at": 0}, {"down": ["control", "option"], "at": 0.05}, {"at": 0.1}, {"down": ["control"], "at": 0.2}, {"at": 0.3}], "expect": {"doubleTaps": []}},
{"name": "⌥ tapped twice is a double tap of ⌥, as the shortcut recorder takes it", "watching": ["control", "option"], "keys": [{"down": ["option"], "at": 0}, {"at": 0.1}, {"down": ["option"], "at": 0.2}, {"at": 0.3}], "expect": {"doubleTaps": ["option"]}},
{"name": "The start double tap starts a session when none is on screen", "tapped": "control", "startKey": "control", "hasSession": false, "expect": {"doubleTapAction": "start"}},
{"name": "The start double tap resumes a paused session", "tapped": "control", "startKey": "control", "hasSession": true, "isPaused": true, "expect": {"doubleTapAction": "resume"}},
{"name": "The start double tap does nothing while annotating", "tapped": "control", "startKey": "control", "hasSession": true, "isPaused": false, "expect": {"doubleTapAction": "nothing"}},
{"name": "One double tap for start and pause also pauses while annotating", "tapped": "control", "startKey": "control", "pauseKey": "control", "hasSession": true, "isPaused": false, "expect": {"doubleTapAction": "togglePause"}},
